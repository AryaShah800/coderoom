# Sync server settings (read from the environment; this file is documentation only).
PORT=1234
# Use 0.0.0.0 on a host like Render (set automatically when RENDER is present)
HOST=127.0.0.1
# Comma-separated origins allowed to connect. Empty = any origin (local development only).
ALLOWED_ORIGINS=http://localhost:3000
MAX_PAYLOAD_BYTES=1048576
MAX_ROOMS=500
MAX_CONNECTIONS_PER_IP=20
# Empty rooms are dropped from memory after this long (ms)
ROOM_TTL_MS=1800000
