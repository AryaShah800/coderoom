# Copy to .env.local for local development. Never commit real values.

# --- Browser (inlined at build time) ---
# WebSocket URL of the separate sync server (sync-server/). Local default shown.
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234

# --- Server only (read by /api/run; never sent to the browser) ---
# Judge0 base URL. Leave empty and Run answers "not configured" (HTTP 503).
# Self-hosted example: http://localhost:2358   Hosted (RapidAPI): https://judge0-ce.p.rapidapi.com
JUDGE0_URL=
# Self-hosted Judge0 with AUTHN enabled: X-Auth-Token value
JUDGE0_AUTH_TOKEN=
# RapidAPI plan: key and host
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
# Upstream timeout in ms (clamped to 1000-30000)
JUDGE0_TIMEOUT_MS=15000
